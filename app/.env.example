# app/.env 로 복사해 채운다. 이 파일(.env.example)에는 비밀을 적지 않는다(research R15).
# DB (팀 MariaDB). 비밀번호는 Intent-Plan.md [데이터베이스 설정]에서 가져와 app/.env 에만 적는다.
DB_HOST=mis.iptime.org
DB_PORT=23306
DB_USER=pioneer3
DB_PASSWORD=
DB_NAME=ABC10pioneer3
# 개발: bash ops/devdb.sh start 후 → DB_HOST=127.0.0.1 DB_PORT=26133 DB_USER=gugak_dev DB_PASSWORD=gugak_dev DB_NAME=gugak_dev

# 포트
WEB_PORT=9523
WEB_HOST=127.0.0.1
ADMIN_PORT=26101
ADMIN_HOST=127.0.0.1
MODEL_API_PORT=9543
MODEL_API_URL=http://127.0.0.1:9543
# 외부 공개 입구(ops/gateway.mjs): p3.sumzip.com → nginx → 192.168.0.19:9503 → /api/v1/* 는 모델 API, 나머지는 웹
GATEWAY_PORT=9503
PUBLIC_API_URL=https://p3.sumzip.com/api

# 비밀
# 필수 · 32자 이상(로그인 쿠키 · 결과 파일 주소 서명 키). 만들기: openssl rand -hex 32 — 없거나 짧으면 웹 서버가 켜지지 않는다
SESSION_SECRET=
SERVICE_API_KEY=
ADMIN_ALLOWED_CIDRS=127.0.0.1/32,::1/128
ADDR_HASH_SALT=

# 저장 위치 — 적지 않으면 기본값: 결과 파일 app/storage · 인식 엔진 ~/gugak-engines (2026-10-01 이 서버 전용 절대 경로 두 줄 삭제)
# 다른 곳을 쓸 때만: STORAGE_DIR=/경로/storage · ENGINES_DIR=/경로/gugak-engines

# 공유 Ollama 서버 (OLLAMA 설정 참조 §7.1) — 모델 이름은 관리자 화면 '모델' 탭(등록부)에서 고른다
OLLAMA_URL=http://127.0.0.1:11434

# API 예시 홈페이지(/demo/, 2026-09-30 조성기 — SD_02 §7-2): 예시 서버(pm2 demo)가 외부 개발자처럼 공개 API 를 부른다
DEMO_PORT=26102
DEMO_API_BASE=https://p3.sumzip.com/api
# 가입 → 로그인 → API활용에서 받은 외부 키(원문은 여기만, 권한 600)
DEMO_API_KEY=
